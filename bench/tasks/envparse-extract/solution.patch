index 0000000..ae5cd16
--- /dev/null
+++ b/tests/test_envparse.py
@@ -0,0 +1,34 @@
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+import envparse  # noqa: E402
+
+
+class ParseTest(unittest.TestCase):
+    def test_key_value_lines(self):
+        self.assertEqual(envparse.parse("A=1\nB=two\n"), {"A": "1", "B": "two"})
+
+    def test_comments_and_blank_lines_are_skipped(self):
+        self.assertEqual(envparse.parse("# note\n\nA=1\n"), {"A": "1"})
+
+    def test_quotes_and_export(self):
+        self.assertEqual(envparse.parse("export A=\"x y\"\nB='z'\n"), {"A": "x y", "B": "z"})
+
+    def test_last_value_wins(self):
+        self.assertEqual(envparse.parse("A=1\nA=2\n"), {"A": "2"})
+
+    def test_lines_without_equals_are_skipped(self):
+        self.assertEqual(envparse.parse("junk\nA=1\n"), {"A": "1"})
+
+    def test_value_keeps_later_equals_signs(self):
+        self.assertEqual(envparse.parse("URL=a?b=1"), {"URL": "a?b=1"})
+
+    def test_mismatched_quotes_are_kept(self):
+        self.assertEqual(envparse.parse("A=\"x'"), {"A": "\"x'"})
+
+
+if __name__ == "__main__":
+    unittest.main()
