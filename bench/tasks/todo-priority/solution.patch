+        with open(os.environ["TODO_FILE"], "w", encoding="utf-8") as fh:
+            fh.write('{"next_id": 2, "items": [{"id": 1, "text": "old", "done": false}]}')
+        self.run_todo("add", "--priority", "high", "new")
+        self.assertEqual(self.run_todo("list"), (0, "2 [ ] new (high)\n1 [ ] old\n"))
+
