+    def test_priority_order_and_marks(self):
+        self.run_todo("add", "a")
+        self.run_todo("add", "--priority", "low", "b")
+        self.run_todo("add", "--priority", "high", "c")
+        self.run_todo("done", "3")
+        self.assertEqual(self.run_todo("list"), (0, "3 [x] c (high)\n1 [ ] a\n2 [ ] b (low)\n"))
+
+    def test_unknown_priority_adds_nothing(self):
+        with self.assertRaises(SystemExit) as caught:
+            self.run_todo("add", "--priority", "urgent", "x")
+        self.assertNotEqual(caught.exception.code, 0)
