diff --git a/linecount.py b/linecount.py
index 2158f35..a4bf833 100644
--- a/linecount.py
+++ b/linecount.py
@@ -4,8 +4,11 @@ import sys
 
 
 def count_lines(text):
-    """Return the number of lines in text."""
-    return text.count("\n")
+    """Return the number of lines in text: one per newline, plus a last line without one."""
+    lines = text.count("\n")
+    if text and not text.endswith("\n"):
+        lines += 1
+    return lines
 
 
