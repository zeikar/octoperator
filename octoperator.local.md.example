---
# Octoperator per-project settings.
# Copy this file to `.claude/octoperator.local.md` in your repo and edit the values.
# It is git-ignored by the plugin (.claude/*.local.md) — never commit it.

# Target repository (owner/name). Defaults to the current repo if omitted.
repo: your-org/your-repo

# Projects v2 board. project_owner may differ from the repo owner (user vs org projects).
project_owner: your-org
project_number: 1
project_url: https://github.com/orgs/your-org/projects/1

# Default milestone applied to new issues (optional).
milestone: v0.1

# Branch name pattern. Tokens: {number}, {slug}. Default: "{number}-{slug}".
branch_pattern: "{number}-{slug}"

# Default reviewers requested on new PRs (GitHub logins). Optional.
reviewers: []

# Status field option names on the board, in flow order. Every board write maps the
# logical status through these keys. Override only if your board uses different names
# (resolved case-insensitively).
statuses:
  todo: Todo
  in_progress: In Progress
  in_review: In Review
  blocked: Blocked
  done: Done

# Autopilot convergence: after this many ledger entries in a row without a gain (a
# merge, or, with genesis's evals, more evals passing), autopilot switches to observe
# mode (propose only) until `--resume`. Default: 3.
convergence_runs: 3

# Approval paths: glob patterns (relative to the repo root) for files a human must
# approve. `auto` holds any PR that touches a match instead of merging it.
# `*` matches within one path segment, `**` across segments. A pattern with a `/` is
# anchored at the repo root (`/infra/` is the top-level `infra/` only); one with no `/`
# matches at any depth (`*.tf` is every `.tf` file). A pattern also covers everything
# under a directory it matches. Default: [] (no gate).
approval_paths: []
---

# Notes
Free-form project notes for humans. Octoperator ignores this section.
